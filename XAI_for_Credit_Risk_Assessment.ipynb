   "source": [
    "from sklearn.calibration import calibration_curve\n",
    "\n",
    "def calibration_plot(model, name):\n",
    "    proba = model.predict_proba(X_valid)[:,1]\n",
    "    frac_pos, mean_pred = calibration_curve(y_valid, proba, n_bins=10, strategy=\"quantile\")\n",
    "    plt.figure()\n",
    "    plt.plot(mean_pred, frac_pos, marker=\"o\", lw=2, label=name)\n",
    "    plt.plot([0,1],[0,1],\"--\")\n",
    "    plt.xlabel(\"Predicted default probability\")\n",
    "    plt.ylabel(\"Observed default rate\")\n",
    "    plt.title(\"Calibration (Quantile bins)\")\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "calibration_plot(logit_pipe, \"Logistic\")\n",
    "calibration_plot(rf_pipe, \"RandomForest\")\n"
   ]
  },
