   "source": [
    "# ============================================================\n",
    "# FEATURE ENGINEERING
    "\n",
    "X_fe = X.copy()\n",
    "\n",
    "# ── 1. Winsorize heavy-tailed variables ──────────────────────\n",
    "for col in [\"RevolvingUtilizationOfUnsecuredLines\", \"DebtRatio\", \"MonthlyIncome\"]:\n",
    "    if col in X_fe.columns:\n",
    "        X_fe[col] = winsorize_series(X_fe[col])\n",
    "\n",
    "# ── 2. Original engineered features ─────────────────────────\n",
    "\n",
    "# Income per dependent — financial strain relative to family size\n",
    "if {\"MonthlyIncome\", \"NumberOfDependents\"}.issubset(X_fe.columns):\n",
    "    X_fe[\"Income_per_Dependent\"] = safe_div(\n",
    "        X_fe[\"MonthlyIncome\"], X_fe[\"NumberOfDependents\"].replace(0, np.nan)\n",
    "    )\n",
    "\n",
    "# Monthly debt proxy — approximate $ amount of monthly debt\n",
    "if {\"DebtRatio\", \"MonthlyIncome\"}.issubset(X_fe.columns):\n",
    "    X_fe[\"MonthlyDebtProxy\"] = X_fe[\"DebtRatio\"] * X_fe[\"MonthlyIncome\"]\n",
    "\n",
    "# Total delinquencies — aggregate all past-due counts\n",
    "dlq_cols = [c for c in X_fe.columns if \"PastDue\" in c or \"90DaysLate\" in c]\n",
    "if dlq_cols:\n",
    "    X_fe[\"Total_Delinquencies\"] = X_fe[dlq_cols].sum(axis=1)\n",
    "\n",
    "# ── 3. NEW: Interaction features ─────────────────────────────\n",
    "\n",
    "# Debt burden — combined pressure from debt ratio AND credit utilization\n",
    "X_fe[\"DebtBurden\"] = X_fe[\"DebtRatio\"] * X_fe[\"RevolvingUtilizationOfUnsecuredLines\"]\n",
    "\n",
    "# Delinquency rate — late payments relative to number of credit lines\n",
    "# (someone with 3 late payments across 20 lines is less risky than 3 across 3)\n",
    "X_fe[\"DelinquencyRate\"] = X_fe[\"Total_Delinquencies\"] / (\n",
    "    X_fe[\"NumberOfOpenCreditLinesAndLoans\"] + 1\n",
    ")\n",
    "\n",
    "# Loans per dependent — credit load relative to family obligations\n",
    "X_fe[\"LoansPerDependent\"] = X_fe[\"NumberOfOpenCreditLinesAndLoans\"] / (\n",
    "    X_fe[\"NumberOfDependents\"] + 1\n",
    ")\n",
    "\n",
    "# ── 4. NEW: Age bucketing ────────────────────────────────────\n",
    "# Age as non-linear risk bands (under 25, 25-35, 35-50, 50-65, 65+)\n",
    "X_fe[\"AgeBucket\"] = pd.cut(\n",
    "    X_fe[\"age\"],\n",
    "    bins=[0, 25, 35, 50, 65, 100],\n",
    "    labels=[0, 1, 2, 3, 4]\n",
    ").astype(float)\n",
    "\n",
    "# ── 5. NEW: High risk flags ──────────────────────────────────\n",
    "# Binary flags for known high-risk thresholds\n",
    "X_fe[\"HighUtilization\"] = (X_fe[\"RevolvingUtilizationOfUnsecuredLines\"] > 0.75).astype(int)\n",
    "X_fe[\"HasSevereDelinquency\"] = (X_fe[\"NumberOfTimes90DaysLate\"] > 0).astype(int)\n",
    "X_fe[\"YoungBorrower\"] = (X_fe[\"age\"] < 30).astype(int)\n",
    "\n",
    "# ── Finalise ─────────────────────────────────────────────────\n",
    "X = X_fe\n",
    "print(f\"Feature set expanded: {X.shape[1]} features total\")\n",
    "print(\"New features added:\")\n",
    "new_features = [\n",
    "    \"DebtBurden\", \"DelinquencyRate\", \"LoansPerDependent\",\n",
    "    \"AgeBucket\", \"HighUtilization\", \"HasSevereDelinquency\", \"YoungBorrower\"\n",
    "]\n",
    "for f in new_features:\n",
    "    print(f\"  ✓ {f}\")\n",
    "\n",
    "X.head()"
   ]
  },
