    "def plot_roc(y_true, proba, label):\n",
    "    fpr, tpr, _ = roc_curve(y_true, proba)\n",
    "    plt.figure()\n",
    "    plt.plot(fpr, tpr, lw=2, label=f\"{label} (AUC={roc_auc_score(y_true, proba):.3f})\")\n",
    "    plt.plot([0,1],[0,1],\"--\")\n",
    "    plt.xlabel(\"FPR\"); plt.ylabel(\"TPR\"); plt.title(\"ROC Curve\"); plt.legend(); plt.show()\n",
    "\n",
    "def plot_pr(y_true, proba, label):\n",
    "    p, r, _ = precision_recall_curve(y_true, proba)\n",
    "    ap = average_precision_score(y_true, proba)\n",
    "    plt.figure()\n",
    "    plt.plot(r, p, lw=2, label=f\"{label} (AP={ap:.3f})\")\n",
    "    plt.xlabel(\"Recall\"); plt.ylabel(\"Precision\"); plt.title(\"Precision-Recall Curve\"); plt.legend(); plt.show()\n",
    "\n",
    "for name, model in [(\"Logistic\", logit_pipe), (\"RandomForest\", rf_pipe)]:\n",
    "    pv = model.predict_proba(X_valid)[:,1]\n",
    "    plot_roc(y_valid, pv, name)\n",
    "    plot_pr(y_valid, pv, name)\n",
    "\n",
    "# Choose a working threshold via F1-max (you can alter to cost-sensitive)\n",
    "def best_threshold_f1(y_true, proba):\n",
    "    ps, rs, ts = precision_recall_curve(y_true, proba)\n",
    "    f1s = (2*ps*rs)/(ps+rs+1e-12)\n",
    "    idx = np.nanargmax(f1s)\n",
    "    return max(ts[idx], 1e-6)\n",
    "\n",
    "th_logit = best_threshold_f1(y_valid, logit_pipe.predict_proba(X_valid)[:,1])\n",
    "th_rf    = best_threshold_f1(y_valid, rf_pipe.predict_proba(X_valid)[:,1])\n",
    "th_logit, th_rf\n"
   ]
  },
